{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "external_directory", "resource": "*", "effect": "allow" },

    { "action": "shell", "resource": "*git push*", "effect": "deny" },
    { "action": "shell", "resource": "*but push*", "effect": "deny" },
    { "action": "shell", "resource": "*but commit*", "effect": "deny" },
    { "action": "shell", "resource": "*but amend*", "effect": "deny" },
    { "action": "shell", "resource": "*but absorb*", "effect": "deny" },
    { "action": "shell", "resource": "*but squash*", "effect": "deny" },
    { "action": "shell", "resource": "*but split*", "effect": "deny" },
    { "action": "shell", "resource": "*but move*", "effect": "deny" },
    { "action": "shell", "resource": "*but pick*", "effect": "deny" },
    { "action": "shell", "resource": "*but reword*", "effect": "deny" },
    { "action": "shell", "resource": "*but pr *", "effect": "deny" },
    { "action": "skill", "resource": "gitbutler", "effect": "deny" },
    { "action": "shell", "resource": "*--no-verify*", "effect": "deny" },
    { "action": "shell", "resource": "*core.hooksPath*", "effect": "deny" },
    { "action": "shell", "resource": "*llama-server*", "effect": "deny" },

    { "action": "edit", "resource": "*AGENTS.md", "effect": "deny" },
    { "action": "edit", "resource": "*CLAUDE.md", "effect": "deny" },
    { "action": "edit", "resource": "*opencode.json", "effect": "deny" },
    { "action": "edit", "resource": "*.claude/*", "effect": "deny" },
    { "action": "edit", "resource": "*.githooks/*", "effect": "deny" },
    { "action": "edit", "resource": "*scripts/agent_check.py", "effect": "deny" },
    { "action": "edit", "resource": "*scripts/perf_evidence.sh", "effect": "deny" },
    { "action": "edit", "resource": "*scripts/ab.py", "effect": "deny" },
    { "action": "edit", "resource": "*scripts/bench_tables.py", "effect": "deny" },
    { "action": "edit", "resource": "*bench/scenes.hpp", "effect": "deny" },
    { "action": "edit", "resource": "*bench/search_bench.cpp", "effect": "deny" },
    { "action": "edit", "resource": "*bench/backends.hpp", "effect": "deny" },
    { "action": "edit", "resource": "*bench/reference.hpp", "effect": "deny" },
    { "action": "edit", "resource": "*support/scene.hpp", "effect": "deny" }
  ]
}
