// Shared by the kernel components (cells, rows, csr, sync): the parameter
// structs C++ passes in, cell keys and the hash lookup, point helpers and the
// row compaction. Everything here is static, so each component gets its own
// copy; ISPC guards the struct definitions in the generated headers, which C++
// includes together through kernels_ispc.h.
//
// All components use 64-bit addressing. 32-bit addressing halves the gather
// instructions of the cell kernels but not their cost on the measured CPUs
// (gathers are split into one load per element either way), and would cap
// every varying index at 2 GB.

#pragma once

// Parameter structs shared with C++ (the generated header defines them in
// namespace ispc). Kernels take them by pointer and copy them into locals
// on entry, so the fields stay in registers instead of being reloaded after
// every store through an output pointer.

// Sorted point coordinates and their original (caller) indices.
struct Points {
  const uniform float *uniform x;
  const uniform float *uniform y;
  const uniform float *uniform z;
  const uniform int *uniform index;
};

// Occupied cells: points [starts[c], ends[c]) of the sorted order, and the
// packed cell coordinate keys[c].
struct Cells {
  const uniform int *uniform starts;
  const uniform int *uniform ends;
  const uniform uint64 *uniform keys;
};

// Dense cell lookup: cells[(z * ny + y) * nx + x] is a cell index or -1,
// with x/y/z relative to (min_x, min_y, min_z).
struct DenseGrid {
  const uniform int *uniform cells;
  uniform int nx, ny, nz;
  uniform int min_x, min_y, min_z;
};

// Open-addressing hash from cell key to cell index.
struct HashGrid {
  const uniform uint64 *uniform keys;
  const uniform int *uniform vals;
  uniform uint64 empty_key;
  uniform uint32 mask;
  // One control byte per slot: 0x80 = empty, otherwise a 7-bit fingerprint.
  const uniform uint8 *uniform control;
};

// Candidate point ranges of each query cell:
// [starts[offset[c] + k], ends[offset[c] + k]) for k < count[c].
struct CellRanges {
  const uniform int *uniform offset;
  const uniform int *uniform count;
  const uniform int *uniform starts;
  const uniform int *uniform ends;
};

// Candidate neighbor cells of each cell: cells[c * stride + k], k < counts[c].
struct NeighborCells {
  const uniform int *uniform cells;
  const uniform int *uniform counts;
  uniform int stride;
};

// x/y/z coordinate arrays.
struct Coords {
  const uniform float *uniform x;
  const uniform float *uniform y;
  const uniform float *uniform z;
};

// Point blocks of dense cells with their bounding boxes [lo, hi], plus
// per-cell bounding boxes [cell_lo, cell_hi]. Cell c owns blocks
// [cell_first[c], + cell_count[c]).
struct Blocks {
  const uniform int *uniform cell_first;
  const uniform int *uniform cell_count;
  const uniform int *uniform begin;
  const uniform int *uniform end;
  const uniform int *uniform cell;
  Coords lo, hi;
  Coords cell_lo, cell_hi;
};

// Fixed-capacity output rows: row q starts at
// neighbors + q * (capacity + programCount); the programCount slack slots
// absorb full-gang compaction stores. perm is the 8-lane compaction lookup
// table (see store_compacted), scratch one row of per-thread staging (only
// used by the _nt writers).
struct FixedRows {
  uniform int capacity;
  const uniform int *uniform perm;
  uniform int *uniform scratch;
  uniform int *uniform counts;
  uniform int *uniform neighbors;
  // Optional per-query block layout. When set, row q starts at
  // neighbors[row_offset[q]] and has row_capacity[q] slots.
  const uniform int *uniform row_offset;
  const uniform int *uniform row_capacity;
};

// Compaction strategy (APFRNN_COMPACT_TABLE overrides it on 8-wide builds):
//   table:    8 lanes with vector-of-int masks (AVX2): one shuffle through
//             the 256x8 lookup table, what the AVX2 writers were tuned with.
//   compress: bit-mask targets (AVX-512, AVX10): register vpcompressd plus a
//             plain full-gang store. Not packed_store_active2: it compresses
//             straight to memory, which is microcoded and 2.5-3.5x slower
//             end to end on Zen 4.
//   generic:  anything else (SSE4, AVX2 x16, ...): packed_store_active2.
#ifndef APFRNN_COMPACT_TABLE
#if TARGET_WIDTH == 8 && ISPC_MASK_BITS != 1
#define APFRNN_COMPACT_TABLE 1
#else
#define APFRNN_COMPACT_TABLE 0
#endif
#endif
#if APFRNN_COMPACT_TABLE && TARGET_WIDTH != 8
#error "APFRNN_COMPACT_TABLE needs an 8-wide target: the table covers 8 lanes"
#endif

// Stores the active lanes of `value` contiguously at out[0, n) and returns n.
// Always writes a whole gang (programCount ints) at `out`, so every buffer
// it writes to needs programCount slack slots past its last valid element.
static inline uniform int store_compacted(uniform int *uniform out,
                                          varying bool active,
                                          varying int value,
                                          const uniform int *uniform perm) {
#if APFRNN_COMPACT_TABLE
  const uniform int mask = packmask(active);
  out[programIndex] = shuffle(value, perm[mask * 8 + programIndex]);
  return popcnt(mask);
#elif ISPC_MASK_BITS == 1
  out[programIndex] = @llvm.experimental.vector.compress(value, active, value);
  return popcnt(packmask(active));
#else
  uniform int added = 0;
  if (active) {
    added = packed_store_active2(out, value);
  }
  return added;
#endif
}

static inline varying uint64 make_key(varying int cx, varying int cy,
                                    varying int cz) {
  varying uint64 ux = ((varying uint64)((varying uint32)cx)) & 0x1FFFFFULL;
  varying uint64 uy = ((varying uint64)((varying uint32)cy)) & 0x1FFFFFULL;
  varying uint64 uz = ((varying uint64)((varying uint32)cz)) & 0x1FFFFFULL;
  return (ux << 42) | (uy << 21) | uz;
}

static inline uniform int unpack_coord_uniform(uniform uint64 key,
                                             uniform int shift) {
  uniform int coord = (uniform int)((key >> shift) & 0x1FFFFFULL);
  if ((coord & 0x100000) != 0) {
    coord -= 0x200000;
  }
  return coord;
}

static inline varying int unpack_coord(varying uint64 key,
                                     uniform int coord_shift) {
  varying int coord =
      (varying int)((varying uint32)((key >> coord_shift) & 0x1FFFFFULL));
  varying bool is_negative = (coord & 0x100000) != 0;
  coord = select(is_negative, (varying int)(coord | 0xFFE00000), coord);
  return coord;
}

static inline varying int find_cell_index(const uniform HashGrid &hash,
                                   varying uint64 key) {
  varying uint64 h64 = (key ^ (key >> 33)) * 0xff51afd7ed558ccdULL;
  h64 ^= h64 >> 33;
  const varying uint8 fingerprint =
      (varying uint8)(h64 >> 56) & (varying uint8)0x7f;
  varying uint32 h = (varying uint32)h64 & hash.mask;

  while (true) {
    const varying uint8 control = hash.control[h];
    if (control == (varying uint8)0x80) {
      return -1;
    }
    if (control == fingerprint && hash.keys[h] == key) {
      return hash.vals[h];
    }
    h = (h + 1) & hash.mask;
  }
}

// Points as short vectors. The arrays stay SoA; these only gather one
// point's x, y and z.
static inline uniform float<3> point_at(const uniform Points &pts,
                                        uniform int i) {
  const uniform float<3> p = {pts.x[i], pts.y[i], pts.z[i]};
  return p;
}
static inline varying float<3> point_at(const uniform Points &pts,
                                        varying int i) {
  const varying float<3> p = {pts.x[i], pts.y[i], pts.z[i]};
  return p;
}
static inline uniform float<3> coords_at(const uniform Coords &c,
                                         uniform int i) {
  const uniform float<3> p = {c.x[i], c.y[i], c.z[i]};
  return p;
}
static inline uniform float length_sq(uniform float<3> d) {
  return d.x * d.x + d.y * d.y + d.z * d.z;
}
static inline varying float length_sq(varying float<3> d) {
  return d.x * d.x + d.y * d.y + d.z * d.z;
}
